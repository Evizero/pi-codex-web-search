{
  "name": "pi-codex-web-search",
  "version": "0.1.0",
  "description": "Pi extension that enables native Codex web_search tool calls (with Codex auth/model gating).",
  "keywords": [
    "pi-package",
    "pi",
    "codex",
    "web-search",
    "openai-codex"
  ],
  "author": "Evizero",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Evizero/pi-codex-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/Evizero/pi-codex-web-search/issues"
  },
  "homepage": "https://github.com/Evizero/pi-codex-web-search#readme",
  "scripts": {
    "fmt": "npx --yes prettier --write extensions/*.ts README.md",
    "lint": "npm run lint:format && npm run lint:types",
    "lint:format": "npx --yes prettier --check extensions/*.ts README.md",
    "lint:types": "node ./scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
